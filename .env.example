# Local development only. Do not reuse these database credentials in production.
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:54329/gateway
GATEWAY_LISTEN=127.0.0.1:8080
GATEWAY_ENV=development
RUST_LOG=open_model_gateway=info

# Only explicitly allowlisted env references can supply provider credentials.
# Inject the actual OPENAI_API_KEY securely; do not put provider secrets in the web app.
GATEWAY_SECRET_ENV_ALLOWLIST=
GATEWAY_MAX_CONCURRENT_REQUESTS=128
GATEWAY_REQUEST_TIMEOUT_SECONDS=120

# Optional settled execution display-metadata compaction (30..3650 days).
# Financial ledger, usage, ownership, and unknown reservations are NOT deleted.
# GATEWAY_EXECUTION_DETAIL_RETENTION_DAYS=365
# Distributed limits/prices/routing are configured through the authenticated dashboard.
# Each replica reconciles expired leases in bounded batches; unknown costs remain held.

# Optional OIDC dashboard login. Register PUBLIC_URL/api/v1/auth/callback.
# Use the browser-visible origin (Vite's 3000 in dev, Rust/TLS origin when serving the build).
# Without an issuer/client ID login stays disabled; there is no dev auth bypass.
# GATEWAY_PUBLIC_URL=http://127.0.0.1:3000
# GATEWAY_OIDC_ISSUER=https://issuer.example.org
# GATEWAY_OIDC_CLIENT_ID=registered-client-id
# Inject GATEWAY_OIDC_CLIENT_SECRET securely if required by the issuer.

# Anthropic uses env:ANTHROPIC_API_KEY (add its name to the allowlist and inject it).
# Bedrock uses aws:default with an explicit region and the AWS workload credential chain.
# No real upstream is enabled automatically.

# Optional: serve the trusted built dashboard from Rust. Unset for API-only mode.
# Relative to the gateway process working directory; build with npm run build:web.
# GATEWAY_WEB_DIR=apps/web/dist
