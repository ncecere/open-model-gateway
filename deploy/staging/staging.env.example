# No credentials here. scripts/staging.py init generates separate private files.
GATEWAY_IMAGE=open-model-gateway:staging
GATEWAY_HOST=localhost
GATEWAY_PUBLIC_URL=https://localhost:18443
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_HTTP_PORT=18080
STAGING_HTTPS_PORT=18443
GATEWAY_MAX_CONCURRENT_REQUESTS=32
GATEWAY_REQUEST_TIMEOUT_SECONDS=120
# Keep shutdown grace above the request deadline plus finalization margin.
GATEWAY_STOP_GRACE_PERIOD=150s
GATEWAY_SECRET_ENV_ALLOWLIST=
# SMTP password reference names only; never a provider key name.
GATEWAY_SMTP_SECRET_ENV_ALLOWLIST=
# SMTP relay hosts email may go to (the relay set in Admin > Settings > Email must be listed).
GATEWAY_SMTP_HOST_ALLOWLIST=
# Private networks the gateway may reach (a private IdP, S3 store or relay), as CIDRs.
GATEWAY_EGRESS_PRIVATE_ALLOW=
# Per-replica pool; size PostgreSQL max_connections for all replicas.
GATEWAY_DATABASE_MAX_CONNECTIONS=10
# Optional metrics listener (docs/operations.md). Unauthenticated: keep it on
# a private network; ingress never routes to it.
# GATEWAY_METRICS_ADDR=0.0.0.0:9464
# Optional digest-pinned PostgreSQL/Caddy overrides. These approved
# mirror.gcr.io digest pins are also the Compose defaults and CI images:
# STAGING_POSTGRES_IMAGE=mirror.gcr.io/library/postgres@sha256:858bb5e98eed02eb8cafbcdc007f9a65d1b613972028944a8ec2133ccaf80d27
# STAGING_CADDY_IMAGE=mirror.gcr.io/library/caddy@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f

# For a real hostname: configure DNS, public ports 80/443, and HTTPS origin.
# Keep the deployment firewalled/private until live acceptance is complete.
# GATEWAY_HOST=gateway.example.org
# GATEWAY_PUBLIC_URL=https://gateway.example.org
# STAGING_BIND_ADDRESS=0.0.0.0
# STAGING_HTTP_PORT=80
# STAGING_HTTPS_PORT=443

# Enable only after registering the HTTPS origin + /api/v1/auth/callback.
# STAGING_OIDC_ENABLED=1
# GATEWAY_OIDC_ISSUER=https://issuer.example.org
# GATEWAY_OIDC_CLIENT_ID=registered-client-id
# For a confidential client, put its secret in secrets/oidc_client_secret first:
# STAGING_OIDC_CONFIDENTIAL=1

# Optional paid-provider acceptance; neither toggle creates/enables a deployment.
# Put the appropriate key in secrets/openai_api_key or secrets/anthropic_api_key.
# STAGING_OPENAI_ENABLED=1
# STAGING_ANTHROPIC_ENABLED=1
# GATEWAY_SECRET_ENV_ALLOWLIST=OPENAI_API_KEY,ANTHROPIC_API_KEY
# For Bedrock, prefer workload identity. An explicit AWS integration is required;
# this baseline disables EC2 instance metadata access and does not mount ~/.aws.
