{
  "operations": {
    "POST /api/v1/platform/reservations/resolve-batch-envelopes": {
      "access": "PlatformWrite",
      "token_policy": "Denied",
      "scope": null,
      "operation": {
        "description": "Explicit browser-session Platform Admin action, separate from free-price eligibility. Bounded aggregate preview/apply of terminal gateway-run UNKNOWN envelopes only; native/nonterminal/ambiguous jobs are excluded. Apply with expected_count and reason. The unused envelope settles at ZERO; line reservations own charges and retain pending/unknown holds. Known settled line sum is evidence, never charged twice. NULL usage and observations remain unchanged. Counts and totals only, including personal workspaces; line held amount is a known floor when line_unbounded_count is positive. Preview is advisory; changed count conflicts atomically. Follow apply next_offset; resolved rows leave the scan. No automatic action or retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchEnvelopeResolutionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Count only, or atomically resolved at zero cost",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchEnvelopeResolutionResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Eligible page count changed; preview again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Invalid JSON shape",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Storage or aggregate accounting unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  }
}
