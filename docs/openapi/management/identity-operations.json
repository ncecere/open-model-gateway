        "400":{"$ref":"#/paths/~1api~1v1~1me/get/responses/400"},"401":{"$ref":"#/paths/~1api~1v1~1me/get/responses/401"},"403":{"$ref":"#/paths/~1api~1v1~1me/get/responses/403"},"409":{"description":"Identity link conflict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IdentityFailure"}}}},
        "429":{"$ref":"#/paths/~1api~1v1~1auth~1login/get/responses/429"},"500":{"$ref":"#/paths/~1api~1v1~1me/get/responses/500"},"503":{"$ref":"#/paths/~1api~1v1~1me/get/responses/503"}
