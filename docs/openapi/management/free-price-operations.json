{
  "operations": {
    "POST /api/v1/platform/reservations/resolve-free-price": {
      "access": "PlatformWrite",
      "token_policy": "Denied",
      "scope": null,
      "operation": {
        "description": "Explicit browser-session Platform Admin action. Preview first, then apply with expected_count and reason. Rechecks pinned pricing and live authority; missing usage remains NULL. Only aggregate counts leave the route, including personal workspaces. No automatic resolution. Nonzero holds, priced/unknown/missing rates, realtime, running executions/jobs and unpinned batch envelopes are excluded. The preview is advisory; applying selects again and refuses a changed count.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FreePriceResolutionInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Count only, or atomically resolved at zero cost",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreePriceResolutionResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Eligible count changed or selectors exceed 10000 zero-hold candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Invalid JSON shape",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Storage or pinned pricing unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  }
}
