              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "tokens"
                },
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "input_tokens",
                "output_tokens",
                "total_tokens"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "duration"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "type",
                "seconds"
              ]
            }
          ]
        }
      },
      "required": [
        "text"
      ]
