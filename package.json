{
  "name": "open-model-gateway",
  "version": "0.3.0",
  "private": true,
  "workspaces": ["apps/web"],
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "openai": "^7.23.0",
    "pg": "8.23.1"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @omg/web",
    "build:web": "npm run build --workspace @omg/web",
    "typecheck:web": "npm run typecheck --workspace @omg/web",
    "test:web": "npm run test --workspace @omg/web",
    "test:demo": "node --test tests/demo-oidc.test.mjs && python3 tests/demo-runtime.test.py",
    "test:container": "node --test tests/container-entrypoint.test.mjs",
    "test:staging": "python3 tests/staging.test.py && python3 tests/provider-acceptance.test.py && python3 tests/backup.test.py",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts"
  }
}
