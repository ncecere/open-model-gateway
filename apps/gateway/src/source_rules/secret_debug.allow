# Database row identifiers for the issuing API key or acting admin token.
auth.rs::<file>::Principal::key_id: Uuid
filestore/files.rs::<file>::NewFile::created_by_api_key_id: Option < Uuid >
filestore/files.rs::<file>::StoredFile::created_by_api_key_id: Option < Uuid >
filestore/upload.rs::<file>::Uploader::api_key_id: Option < Uuid >
governance/locks.rs::<file>::Touch::api_key: Uuid
governance/reconcile.rs::<file>::ReconcilingActor::token_id: Option < Uuid >
jobs/store.rs::<file>::JobRow::api_key_id: Uuid

# Estimated audio token charges in integer micro-USD.
billing.rs::<file>::AudioTokenCostComponents::cache_read_audio_tokens_microusd: i64
billing.rs::<file>::AudioTokenCostComponents::input_audio_tokens_microusd: i64
billing.rs::<file>::AudioTokenCostComponents::output_audio_tokens_microusd: i64

# Numeric model token counts, billing thresholds and capacity limits.
billing.rs::<file>::BillingUsage::cache_read_input_tokens: Option < u64 >
billing.rs::<file>::BillingUsage::cache_write_1h_input_tokens: Option < u64 >
billing.rs::<file>::BillingUsage::cache_write_5m_input_tokens: Option < u64 >
billing.rs::<file>::BillingUsage::cache_write_default_input_tokens: Option < u64 >
billing.rs::<file>::BillingUsage::cache_write_input_tokens: Option < u64 >
billing.rs::<file>::BillingUsage::total_input_tokens: Option < u64 >
billing.rs::<file>::BillingUsage::uncached_input_tokens: Option < u64 >
billing/v3.rs::<file>::PriceLine::min_prompt_tokens: Option < u64 >
governance/rates.rs::<file>::Counters::tokens: i128
governance/rates.rs::<file>::Limits::tokens_per_minute: Option < i64 >
inference/realtime.rs::<file>::RealtimeLimits::max_output_tokens: u32
inference/realtime.rs::<file>::RealtimeSetup::window_output_tokens: u32
inference/realtime.rs::<file>::RealtimeUsage::cached_audio_tokens: u64
inference/realtime.rs::<file>::RealtimeUsage::cached_text_tokens: u64
inference/realtime.rs::<file>::RealtimeUsage::input_audio_tokens: u64
inference/realtime.rs::<file>::RealtimeUsage::input_text_tokens: u64
inference/realtime.rs::<file>::RealtimeUsage::output_audio_tokens: u64
inference/realtime.rs::<file>::RealtimeUsage::output_text_tokens: u64
inference/realtime/context.rs::<file>::Growth::audio_tokens: u64
inference/realtime/context.rs::<file>::Growth::text_tokens: u64
inference/realtime/context.rs::<file>::Prior::audio_tokens: u64
inference/realtime/context.rs::<file>::Prior::text_tokens: u64
inference/repository.rs::<file>::GenerationAdmission::max_output_tokens: Option < u32 >
inference/types.rs::<file>::Usage::input_tokens: Option < u64 >
inference/types.rs::<file>::Usage::output_tokens: Option < u64 >
inference/types.rs::<file>::Usage::reasoning_tokens: Option < u64 >
inference/workload.rs::<file>::OutputReservation::Batch::output_tokens: u64
management/governance/policies.rs::<file>::Limits::tokens_per_minute: Option < i64 >
protocols/realtime/events.rs::<file>::ClientAction::ResponseCreate::max_output_tokens: u32

# Master key labels used in object metadata and the verification report. by_key_id maps labels to object counts.
filestore/files.rs::<file>::StoredFile::encryption_key_id: String
filestore/mod.rs::<file>::StoreHealth::key_id: String
filestore/mod.rs::<file>::StoredObject::key_id: String
filestore/sweep.rs::<file>::VerifyReport::active_key_id: Option < String >
filestore/sweep.rs::<file>::VerifyReport::by_key_id: std :: collections :: BTreeMap < String , u64 >
filestore/sweep.rs::<file>::VerifyReport::retired_key_ids_in_use: Vec < String >
filestore/sweep.rs::<file>::VerifyReport::unknown_key_ids: Vec < String >

# ObjectKey is a gateway-generated storage path built from a prefix, scope and object UUID.
filestore/files.rs::<file>::StoredFile::key: ObjectKey
filestore/mod.rs::<file>::StoredObject::key: ObjectKey

# Count of published verification keys.
identity/jwks.rs::<file>::JwksStatus::keys: usize

# Elapsed milliseconds until the first generated token.
inference/repository.rs::<file>::AttemptTelemetry::time_to_first_token_ms: Option < u64 >

# Numeric limits on issued keys.
management/governance/policies.rs::<file>::Limits::key_issuances_per_holder: Option < i64 >
management/governance/policies.rs::<file>::Limits::key_issuances_per_workspace: Option < i64 >

# SecretImport::fmt emits a fixed redaction for value. startup::tests::debug_output_is_redacted exercises it.
startup.rs::<file>::impl Debug for SecretImport => startup.rs::<file>::SecretImport::value: OsString
