# Deny by default: only build inputs enter context. The runtime image is
# distroless; the binary is its own entrypoint (no shell scripts).
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!package.json
!package-lock.json
!apps/
!apps/gateway/
!apps/gateway/Cargo.toml
!apps/gateway/src/
!apps/gateway/src/**
!apps/gateway/migrations/
!apps/gateway/migrations/*.sql
!tools/
!tools/mock-upstream/
!tools/mock-upstream/Cargo.toml
!tools/mock-upstream/src/
!tools/mock-upstream/src/**
!tools/loadgen/
!tools/loadgen/Cargo.toml
!tools/loadgen/seed.sql
!tools/loadgen/src/
!tools/loadgen/src/**
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/tsconfig*.json
!apps/web/vite.config.ts
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**

# Defense in depth inside allowed source trees. No environment files (including
# examples) are needed to build or run this image.
**/.git
**/.git/**
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/target
**/target/**
**/dist
**/dist/**
**/secrets
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/screenshots
**/screenshots/**
**/backups
**/backups/**
**/*.bak
**/coverage
**/coverage/**
**/test-results
**/test-results/**
**/playwright-report
**/playwright-report/**
**/.DS_Store
ai.env
